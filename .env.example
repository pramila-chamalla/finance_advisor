# Copy this file to .env and add a newly rotated provider key if you want live AI.
OPENAI_API_KEY=replace_with_your_rotated_api_key
MODEL=gpt-oss-120b
# Optional for OpenAI-compatible providers:
OPENAI_BASE_URL=

# Optional: set a different database file (default: backend/database/finance.db).
# FINANCE_DB_PATH=

# Optional: override the FastAPI URL used by Streamlit.
# FINANCE_API_URL=http://127.0.0.1:8000
